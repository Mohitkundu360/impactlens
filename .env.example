# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/impactlens?schema=public"

# --- Cloudinary ---
# From your Cloudinary Console > Settings > API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Public, safe to expose to the client (used by the upload widget/client SDK)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Optional: enable Cloudinary AI Vision as an alternate AnalysisProvider (Beta add-on).
# Leave false for MVP — Gemini is the default/guaranteed analysis path.
CLOUDINARY_AI_VISION_ENABLED=false

# Optional: enable Cloudinary AI Video Analysis for native timestamped video scenes
# (Beta). If disabled or if a job fails/times out, the worker automatically falls
# back to frame-based video analysis via Gemini — never required for the demo path.
CLOUDINARY_AI_VIDEO_ANALYSIS_ENABLED=false

# --- AI (Gemini) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# --- App ---
NEXTAUTH_URL="http://localhost:3000"
